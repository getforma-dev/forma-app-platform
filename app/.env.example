# Non-secret deployment identifiers come from the reviewed CDK outputs.
# This example is intentionally incomplete and refused; no secret belongs here.
AWS_REGION=us-east-1
GENUI_DATABASE_HOST=REPLACE_ME
GENUI_DATABASE_NAME=genui
GENUI_DATABASE_ROLES_JSON=REPLACE_ME
GENUI_TENANTS_JSON=REPLACE_ME
GENUI_EVIDENCE_BUCKET=REPLACE_ME
GENUI_RUNTIME_CONFIG_FILE=/run/genui/credentials.json
GENUI_RDS_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem
GENUI_HELPER_PATH=/app/runtime.py
FORMA_BIND_ADDRESS=127.0.0.1
FORMA_PORT=3000
