{
  "type": "object",
  "properties": {
    "kind": {
      "const": "shared_query_receipt"
    },
    "schema_version": {
      "const": 1
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "mode": {
      "const": "published"
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "view_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "operator_version": {
      "const": 1
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "$ref": "schema.json#/$defs/source_dependency"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "record_snapshot_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "schema.json#/$defs/named_value"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "filter_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "partial": {
      "const": false
    },
    "truncated_page": {
      "type": "boolean"
    },
    "total_scope": {
      "const": "full_authorized_filtered_input"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "query_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "predicate_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "query_digest",
        "predicate_digest"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "share_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "share_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "schema_version",
    "organization_id",
    "app_id",
    "work_id",
    "mode",
    "definition_digest",
    "view_id",
    "operator_version",
    "source_revisions",
    "record_snapshot_sequence",
    "parameters",
    "policy_epoch",
    "filter_epoch",
    "result_digest",
    "partial",
    "truncated_page",
    "total_scope",
    "provenance",
    "digest",
    "account_id",
    "share_id",
    "share_version",
    "publication_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getforma.dev/contracts/shared-query-receipt-v1.schema.json",
  "title": "Named live app share query receipt"
}
