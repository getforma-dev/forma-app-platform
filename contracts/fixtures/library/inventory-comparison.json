    "content": {
      "title": "Inventory comparison",
      "description": "Units on hand by warehouse and product, the low-stock SKUs, and a reorder decision form. Prebuilt library app on labeled synthetic data (ADR-011 pitch).",
      "inputs": [
        {
          "id": "inventory",
          "contract_id": "inventory_levels_v1",
          "contract_version": 1,
          "kind": "source",
          "fields": [
            {
              "id": "sku",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "product",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "warehouse",
              "value_type": {
                "type": "enum",
                "values": [
                  "austin",
                  "reno",
                  "newark"
                ]
              },
              "nullable": false
            },
            {
              "id": "on_hand",
              "value_type": {
                "type": "integer",
                "unit": "each"
              },
              "nullable": false
            },
            {
              "id": "reorder_point",
              "value_type": {
                "type": "integer",
                "unit": "each"
              },
              "nullable": false
            },
            {
              "id": "unit_cost",
              "value_type": {
                "type": "money",
                "currency": "USD",
                "minor_unit_exponent": 2
              },
              "nullable": false
            }
          ]
        },
        {
          "id": "decisions",
          "contract_id": "decisions_v1",
          "contract_version": 1,
          "kind": "records",
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "views": [
        {
          "id": "by_warehouse",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Units on hand by warehouse",
          "query": {
            "operator_version": 1,
            "inputs": [
              "inventory"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "inventory",
                    "field_id": "warehouse"
                  }
                ],
                "measures": [
                  {
                    "id": "skus",
                    "operation": "count",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "sku"
                    }
                  },
                  {
                    "id": "units",
                    "operation": "sum",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "on_hand"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_product",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Units on hand by product",
          "query": {
            "operator_version": 1,
            "inputs": [
              "inventory"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "inventory",
                    "field_id": "product"
                  }
                ],
                "measures": [
                  {
                    "id": "units",
                    "operation": "sum",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "on_hand"
                    }
                  },
                  {
                    "id": "lowest_warehouse",
                    "operation": "min",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "on_hand"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "low_stock",
          "kind": "table",
          "renderer_version": 1,
          "title": "SKUs under 25 units",
          "query": {
            "operator_version": 1,
            "inputs": [
              "inventory"
            ],
            "operations": [
              {
                "type": "filter",
                "field": {
                  "input_id": "inventory",
                  "field_id": "on_hand"
                },
                "comparison": "lt",
                "value": {
                  "type": "integer",
                  "value": "25",
                  "unit": "each"
                }
              },
              {
                "type": "project",
                "fields": [
                  {
                    "input_id": "inventory",
                    "field_id": "sku"
                  },
                  {
                    "input_id": "inventory",
                    "field_id": "product"
                  },
                  {
                    "input_id": "inventory",
                    "field_id": "warehouse"
                  },
                  {
                    "input_id": "inventory",
                    "field_id": "on_hand"
                  },
                  {
                    "input_id": "inventory",
                    "field_id": "reorder_point"
                  },
                  {
                    "input_id": "inventory",
                    "field_id": "unit_cost"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "inventory",
                      "field_id": "on_hand"
                    },
                    "direction": "asc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "inventory",
                  "field_id": "sku"
                }
              },
              {
                "type": "limit",
                "rows": 50
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "totals",
          "kind": "summary",
          "renderer_version": 1,
          "title": "Inventory totals",
          "query": {
            "operator_version": 1,
            "inputs": [
              "inventory"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [],
                "measures": [
                  {
                    "id": "skus",
                    "operation": "count",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "sku"
                    }
                  },
                  {
                    "id": "units",
                    "operation": "sum",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "on_hand"
                    }
                  },
                  {
                    "id": "highest_unit_cost",
                    "operation": "max",
                    "field": {
                      "input_id": "inventory",
                      "field_id": "unit_cost"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "reorder",
          "kind": "form",
          "renderer_version": 1,
          "title": "Record a reorder decision",
          "command_id": "record_decision"
        }
