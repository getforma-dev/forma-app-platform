    "revision_id": "00000000-0000-4000-8000-000000001082",
    "content": {
      "title": "Vendor spend breakdown",
      "description": "Spend by vendor and category from issued invoices, the unpaid invoices by due date, and a decision form. Prebuilt library app on labeled synthetic data (ADR-011 pitch).",
      "inputs": [
        {
          "id": "vendor_invoices",
          "contract_id": "vendor_invoices_v1",
          "contract_version": 1,
          "kind": "source",
          "fields": [
            {
              "id": "invoice_id",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "time",
              "value_type": {
                "type": "timestamp"
              },
              "nullable": false
            },
            {
              "id": "vendor",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "category",
              "value_type": {
                "type": "enum",
                "values": [
                  "travel",
                  "software",
                  "equipment",
                  "meals",
                  "services",
                  "facilities"
                ]
              },
              "nullable": false
            },
            {
              "id": "amount",
              "value_type": {
                "type": "money",
                "currency": "USD",
                "minor_unit_exponent": 2
              },
              "nullable": false
            },
            {
              "id": "due",
              "value_type": {
                "type": "date"
              },
              "nullable": false
            },
            {
              "id": "paid",
              "value_type": {
                "type": "boolean"
              },
              "nullable": false
            }
          ]
        },
        {
          "id": "decisions",
          "contract_id": "decisions_v1",
          "contract_version": 1,
          "kind": "records",
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "views": [
        {
          "id": "totals",
          "kind": "summary",
          "renderer_version": 1,
          "title": "Invoices and total spend",
          "query": {
            "operator_version": 1,
            "inputs": [
              "vendor_invoices"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [],
                "measures": [
                  {
                    "id": "invoices",
                    "operation": "count",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "invoice_id"
                    }
                  },
                  {
                    "id": "total_spend",
                    "operation": "sum",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "amount"
                    }
                  },
                  {
                    "id": "largest_invoice",
                    "operation": "max",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "amount"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_vendor",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Spend by vendor",
          "query": {
            "operator_version": 1,
            "inputs": [
              "vendor_invoices"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "vendor"
                  }
                ],
                "measures": [
                  {
                    "id": "invoices",
                    "operation": "count",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "invoice_id"
                    }
                  },
                  {
                    "id": "spend",
                    "operation": "sum",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "amount"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_category",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Spend by category",
          "query": {
            "operator_version": 1,
            "inputs": [
              "vendor_invoices"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "category"
                  }
                ],
                "measures": [
                  {
                    "id": "spend",
                    "operation": "sum",
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "amount"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "unpaid",
          "kind": "table",
          "renderer_version": 1,
          "title": "Unpaid invoices by due date",
          "query": {
            "operator_version": 1,
            "inputs": [
              "vendor_invoices"
            ],
            "operations": [
              {
                "type": "filter",
                "field": {
                  "input_id": "vendor_invoices",
                  "field_id": "paid"
                },
                "comparison": "eq",
                "value": {
                  "type": "boolean",
                  "value": false
                }
              },
              {
                "type": "project",
                "fields": [
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "invoice_id"
                  },
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "vendor"
                  },
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "amount"
                  },
                  {
                    "input_id": "vendor_invoices",
                    "field_id": "due"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "vendor_invoices",
                      "field_id": "due"
                    },
                    "direction": "asc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "vendor_invoices",
                  "field_id": "invoice_id"
                }
              },
              {
                "type": "limit",
                "rows": 50
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "decision",
          "kind": "form",
          "renderer_version": 1,
          "title": "Record a vendor review decision",
          "command_id": "record_decision"
        }
      ],
      "record_schemas": [
        {
          "id": "decision",
          "version": 1,
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "commands": [
        {
          "id": "record_decision",
          "record_schema_id": "decision",
          "operation": "create",
          "writable_fields": [
            "status",
            "note"
          ],
          "transitions": [
            {
              "field_id": "status",
              "from": "needs_context",
              "to": "reviewed"
            }
          ]
        }
      ],
