                  },
                  {
                    "input_id": "discount_requests",
                    "field_id": "status"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "discount_requests",
                      "field_id": "discount_pct"
                    },
                    "direction": "desc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "discount_requests",
                  "field_id": "request_id"
                }
              },
              {
                "type": "limit",
                "rows": 50
              }
            ],
