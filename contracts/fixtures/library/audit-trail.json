    "content": {
      "title": "Audit trail viewer",
      "description": "Recent audit events, events by action and outcome, denied actions, and a review form. Prebuilt library app on labeled synthetic data (ADR-011 pitch).",
      "inputs": [
        {
          "id": "audit_log",
          "contract_id": "audit_log_v1",
          "contract_version": 1,
          "kind": "source",
          "fields": [
            {
              "id": "time",
              "value_type": {
                "type": "timestamp"
              },
              "nullable": false
            },
            {
              "id": "actor",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "action",
              "value_type": {
                "type": "enum",
                "values": [
                  "login",
                  "export",
                  "grant",
                  "revoke",
                  "publish",
                  "delete"
                ]
              },
              "nullable": false
            },
            {
              "id": "resource",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "outcome",
              "value_type": {
                "type": "enum",
                "values": [
                  "success",
                  "denied"
                ]
              },
              "nullable": false
            }
          ]
        },
        {
          "id": "decisions",
          "contract_id": "decisions_v1",
          "contract_version": 1,
          "kind": "records",
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "views": [
        {
          "id": "recent",
          "kind": "table",
          "renderer_version": 1,
          "title": "Recent events",
          "query": {
            "operator_version": 1,
            "inputs": [
              "audit_log"
            ],
            "operations": [
              {
                "type": "project",
                "fields": [
                  {
                    "input_id": "audit_log",
                    "field_id": "time"
                  },
                  {
                    "input_id": "audit_log",
                    "field_id": "actor"
                  },
                  {
                    "input_id": "audit_log",
                    "field_id": "action"
                  },
                  {
                    "input_id": "audit_log",
                    "field_id": "resource"
                  },
                  {
                    "input_id": "audit_log",
                    "field_id": "outcome"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "audit_log",
                      "field_id": "time"
                    },
                    "direction": "desc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "audit_log",
                  "field_id": "actor"
                }
              },
              {
                "type": "limit",
                "rows": 50
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_action",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Events by action",
          "query": {
            "operator_version": 1,
            "inputs": [
              "audit_log"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "audit_log",
                    "field_id": "action"
                  }
                ],
                "measures": [
                  {
                    "id": "events",
                    "operation": "count",
                    "field": {
                      "input_id": "audit_log",
                      "field_id": "actor"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "denied",
          "kind": "summary",
          "renderer_version": 1,
          "title": "Denied actions",
          "query": {
            "operator_version": 1,
            "inputs": [
              "audit_log"
            ],
            "operations": [
              {
                "type": "filter",
                "field": {
                  "input_id": "audit_log",
                  "field_id": "outcome"
                },
                "comparison": "eq",
                "value": {
                  "type": "enum",
                  "value": "denied"
                }
              },
              {
                "type": "aggregate",
                "group_by": [],
                "measures": [
                  {
                    "id": "denied",
                    "operation": "count",
                    "field": {
                      "input_id": "audit_log",
                      "field_id": "actor"
                    }
                  },
                  {
                    "id": "latest",
                    "operation": "max",
                    "field": {
                      "input_id": "audit_log",
                      "field_id": "time"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "timeline",
          "kind": "timeline",
          "renderer_version": 1,
          "title": "Events per hour",
          "query": {
            "operator_version": 1,
            "inputs": [
              "audit_log"
            ],
            "operations": [
              {
                "type": "time_bucket",
                "field": {
                  "input_id": "audit_log",
                  "field_id": "time"
                },
                "seconds": 3600,
                "timezone": "UTC",
                "output_field": "time"
              },
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "audit_log",
                    "field_id": "time"
                  }
                ],
                "measures": [
                  {
                    "id": "events",
                    "operation": "count",
                    "field": {
                      "input_id": "audit_log",
                      "field_id": "actor"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "review",
          "kind": "form",
          "renderer_version": 1,
          "title": "Record an audit review",
          "command_id": "record_decision"
        }
      ],
      "record_schemas": [
        {
          "id": "decision",
          "version": 1,
          "fields": [
