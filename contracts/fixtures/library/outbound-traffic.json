    "content": {
      "title": "Outbound traffic investigation",
      "description": "Northstar's Security case: outbound bytes by destination and hour for the organization's assets, the largest transfers, and an observation form. Prebuilt library app on labeled synthetic data (ADR-011 pitch).",
      "inputs": [
        {
          "id": "traffic",
          "contract_id": "traffic_v1",
          "contract_version": 1,
          "kind": "source",
          "fields": [
            {
              "id": "time",
              "value_type": {
                "type": "timestamp"
              },
              "nullable": false
            },
            {
              "id": "asset",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "destination",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "bytes",
              "value_type": {
                "type": "integer",
                "unit": "byte"
              },
              "nullable": false
            },
            {
              "id": "protocol",
              "value_type": {
                "type": "enum",
                "values": [
                  "tcp",
                  "udp",
                  "icmp"
                ]
              },
              "nullable": false
            }
          ]
        },
        {
          "id": "decisions",
          "contract_id": "decisions_v1",
          "contract_version": 1,
          "kind": "records",
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "views": [
        {
          "id": "total",
          "kind": "summary",
          "renderer_version": 1,
          "title": "Total outbound bytes",
          "query": {
            "operator_version": 1,
            "inputs": [
              "traffic"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [],
                "measures": [
                  {
                    "id": "connections",
                    "operation": "count",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "destination"
                    }
                  },
                  {
                    "id": "total_bytes",
                    "operation": "sum",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "bytes"
                    }
                  },
                  {
                    "id": "largest_transfer",
                    "operation": "max",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "bytes"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_destination",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Bytes by destination",
          "query": {
            "operator_version": 1,
            "inputs": [
              "traffic"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "traffic",
                    "field_id": "destination"
                  }
                ],
                "measures": [
                  {
                    "id": "connections",
                    "operation": "count",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "destination"
                    }
                  },
                  {
                    "id": "bytes",
                    "operation": "sum",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "bytes"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "timeline",
          "kind": "timeline",
          "renderer_version": 1,
          "title": "Bytes per hour",
          "query": {
            "operator_version": 1,
            "inputs": [
              "traffic"
            ],
            "operations": [
              {
                "type": "time_bucket",
                "field": {
                  "input_id": "traffic",
                  "field_id": "time"
                },
                "seconds": 3600,
                "timezone": "UTC",
                "output_field": "time"
              },
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "traffic",
                    "field_id": "time"
                  }
                ],
                "measures": [
                  {
                    "id": "bytes",
                    "operation": "sum",
                    "field": {
                      "input_id": "traffic",
                      "field_id": "bytes"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "largest",
          "kind": "table",
          "renderer_version": 1,
          "title": "Largest transfers",
          "query": {
            "operator_version": 1,
            "inputs": [
              "traffic"
            ],
            "operations": [
              {
                "type": "project",
                "fields": [
                  {
                    "input_id": "traffic",
                    "field_id": "time"
                  },
                  {
                    "input_id": "traffic",
                    "field_id": "asset"
                  },
                  {
                    "input_id": "traffic",
                    "field_id": "destination"
                  },
                  {
                    "input_id": "traffic",
                    "field_id": "protocol"
                  },
                  {
                    "input_id": "traffic",
                    "field_id": "bytes"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "traffic",
                      "field_id": "bytes"
                    },
                    "direction": "desc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "traffic",
                  "field_id": "time"
                }
              },
              {
                "type": "limit",
                "rows": 25
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "record_observation",
          "kind": "form",
          "renderer_version": 1,
          "title": "Record an observation",
          "command_id": "record_decision"
        },
        {
          "id": "caution",
          "kind": "note",
          "renderer_version": 1,
          "title": "Caution",
          "text": "An unmatched destination does not establish compromise."
