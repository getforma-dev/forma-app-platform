    "content": {
      "title": "Hiring funnel",
      "description": "Candidates by stage, role and source, the recent applicants, and a screening decision form. Prebuilt library app on labeled synthetic data (ADR-011 pitch).",
      "inputs": [
        {
          "id": "candidates",
          "contract_id": "candidates_v1",
          "contract_version": 1,
          "kind": "source",
          "fields": [
            {
              "id": "candidate_id",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "time",
              "value_type": {
                "type": "timestamp"
              },
              "nullable": false
            },
            {
              "id": "role",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            },
            {
              "id": "stage",
              "value_type": {
                "type": "enum",
                "values": [
                  "applied",
                  "screen",
                  "onsite",
                  "offer",
                  "hired",
                  "rejected"
                ]
              },
              "nullable": false
            },
            {
              "id": "source",
              "value_type": {
                "type": "enum",
                "values": [
                  "referral",
                  "inbound",
                  "agency"
                ]
              },
              "nullable": false
            }
          ]
        },
        {
          "id": "decisions",
          "contract_id": "decisions_v1",
          "contract_version": 1,
          "kind": "records",
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "views": [
        {
          "id": "by_stage",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Candidates by stage",
          "query": {
            "operator_version": 1,
            "inputs": [
              "candidates"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "candidates",
                    "field_id": "stage"
                  }
                ],
                "measures": [
                  {
                    "id": "candidates",
                    "operation": "count",
                    "field": {
                      "input_id": "candidates",
                      "field_id": "candidate_id"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_source",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Candidates by source",
          "query": {
            "operator_version": 1,
            "inputs": [
              "candidates"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "candidates",
                    "field_id": "source"
                  }
                ],
                "measures": [
                  {
                    "id": "candidates",
                    "operation": "count",
                    "field": {
                      "input_id": "candidates",
                      "field_id": "candidate_id"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "by_role",
          "kind": "chart",
          "renderer_version": 1,
          "title": "Candidates by role",
          "query": {
            "operator_version": 1,
            "inputs": [
              "candidates"
            ],
            "operations": [
              {
                "type": "aggregate",
                "group_by": [
                  {
                    "input_id": "candidates",
                    "field_id": "role"
                  }
                ],
                "measures": [
                  {
                    "id": "candidates",
                    "operation": "count",
                    "field": {
                      "input_id": "candidates",
                      "field_id": "candidate_id"
                    }
                  },
                  {
                    "id": "latest_application",
                    "operation": "max",
                    "field": {
                      "input_id": "candidates",
                      "field_id": "time"
                    }
                  }
                ]
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "recent",
          "kind": "table",
          "renderer_version": 1,
          "title": "Recent applicants",
          "query": {
            "operator_version": 1,
            "inputs": [
              "candidates"
            ],
            "operations": [
              {
                "type": "project",
                "fields": [
                  {
                    "input_id": "candidates",
                    "field_id": "candidate_id"
                  },
                  {
                    "input_id": "candidates",
                    "field_id": "time"
                  },
                  {
                    "input_id": "candidates",
                    "field_id": "role"
                  },
                  {
                    "input_id": "candidates",
                    "field_id": "stage"
                  },
                  {
                    "input_id": "candidates",
                    "field_id": "source"
                  }
                ]
              },
              {
                "type": "sort",
                "fields": [
                  {
                    "field": {
                      "input_id": "candidates",
                      "field_id": "time"
                    },
                    "direction": "desc"
                  }
                ],
                "stable_tiebreak": {
                  "input_id": "candidates",
                  "field_id": "candidate_id"
                }
              },
              {
                "type": "limit",
                "rows": 50
              }
            ],
            "null_policy": "unknown"
          }
        },
        {
          "id": "screening",
          "kind": "form",
          "renderer_version": 1,
          "title": "Record a screening decision",
          "command_id": "record_decision"
        }
      ],
      "record_schemas": [
        {
          "id": "decision",
          "version": 1,
          "fields": [
            {
              "id": "status",
              "value_type": {
                "type": "enum",
                "values": [
                  "needs_context",
                  "reviewed"
                ]
              },
              "nullable": false
            },
            {
              "id": "note",
              "value_type": {
                "type": "text"
              },
              "nullable": false
            }
          ]
        }
      ],
      "commands": [
        {
          "id": "record_decision",
          "record_schema_id": "decision",
          "operation": "create",
          "writable_fields": [
            "status",
            "note"
          ],
          "transitions": [
            {
              "field_id": "status",
              "from": "needs_context",
              "to": "reviewed"
            }
          ]
        }
      ],
