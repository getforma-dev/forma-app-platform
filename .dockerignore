# Repository-root context: only explicit image inputs, never credentials,
# evidence, caches, generated assets, dependencies or operator state.
**
!.dockerignore
!app/
app/**
!app/Dockerfile
!app/Cargo.toml
!app/Cargo.lock
!app/src/
app/src/**
!app/src/lib.rs
!app/src/main.rs
!app/src/config.rs
!app/src/readiness.rs
!app/src/roles.rs
!app/src/auth_qualification.rs
!app/src/auth_qualification/
app/src/auth_qualification/**
!app/src/auth_qualification/tests.rs
!app/src/storage/
app/src/storage/**
!app/src/storage/mod.rs
!app/src/storage/admission.rs
!app/src/storage/pool.rs
!app/src/storage/registry.rs
!app/src/storage/authorization.rs
!app/src/storage/catalog.rs
!app/src/storage/tests.rs
!app/src/storage/qualification.rs
!app/src/storage/qualification_cases.rs
!app/src/admission/
app/src/admission/**
!app/src/admission/mod.rs
!app/src/admission/canonical.rs
!app/src/admission/digest.rs
!app/src/admission/validate.rs
# admission/tests.rs is cfg(test) only; its include_str! of ../contracts/ never compiles in a release build.
!app/admin/
app/admin/**
!app/admin/package.json
!app/admin/package-lock.json
!app/admin/build.ts
!app/admin/tsconfig.json
!app/admin/src/
app/admin/src/**
!app/admin/src/home/
app/admin/src/home/**
!app/admin/src/home/app.tsx
!app/admin/src/about/
app/admin/src/about/**
!app/admin/src/about/app.tsx
!app/admin/src/styles/
app/admin/src/styles/**
!app/admin/src/styles/app.css
!app/runtime/
app/runtime/**
!app/runtime/runtime.py
!app/runtime/requirements.lock
!app/migrations/
app/migrations/**
!app/migrations/0001_role_foundation.sql
!app/migrations/0002_tenant_foundation.sql
!app/migrations/0003_admission.sql
!app/migrations/0004_entitlement_reads.sql
